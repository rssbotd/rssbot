#!/usr/bin/env python3
# This file is placed in the Public Domain.
# pylint: disable=C0413


"stress test"


import os
import shutil
import sys
import threading
import time


sys.path.insert(0, os.getcwd())


from nixt.defines import Boot, Commands, Main, MD5, Message, Method, Mods
from nixt.defines import Parser, Pool, Screen, Threading, Time, Workdir


Workdir.wdr = ".test"


class Kernel(Boot):

    "at first."

    nrevents = 0

    @classmethod
    def banner(cls, force=False):
        "hello."
        if not force and not Main.verbose:
            return
        timr = time.ctime(time.time()).replace("  ", " ")
        print(f"{Main.name.upper()} {timr} {Main.level.upper() or 'INFO'} {MD5.core()}")
        sys.stdout.flush()

    @classmethod
    def boot(cls):
        "booting the kernel."
        cls.configure()
        Mods.dir("mods", Workdir.moddir())
        Mods.dir("module", Mods.moddir())
        Mods.dir("examples", "examples")
        if "local" in Main.opts:
            Mods.dir("mods", "mods")
        if "all" in Main.opts:
            Main.mods = ",".join(Mods.list())
        if "verbose" in Main.verbose:
            cls.banner()
        Commands.table()
        Mods.table()
        if Main.scanner:
            Commands.scanner()

    @classmethod
    def wrap(cls, func, *args, dofinal=None):
        "restore console."
        import termios
        try:
            olt = termios.tcgetattr(sys.stdin.fileno())
        except termios.error:
            olt = False
        try:
            cls.wrapped(func, *args)
        except (KeyboardInterrupt, EOFError):
            pass
        if olt:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, olt)
        if dofinal:
            final()


class CLI(Screen):

    "Command Line Interface"

    def __init__(self):
        Screen.__init__(self)
        self.register("command", Commands.command)

    def raw(self, text):
        "write to console."
        if "v" in Main.opts:
            print(text.encode('utf-8', 'replace').decode("utf-8"))
            sys.stdout.flush()


def payload(todo):
    "payload to run."
    for cmd, example in todo.items():
        for ex in example:
            Kernel.nrevents += 1
            evt = Message()
            evt.kind = "command"
            evt.text = f"{cmd} {ex}"
            Pool.put(evt)


def final():
    "finalizer."
    if "v" not in Main.opts:
        return
    total = Kernel.nrevents
    endtime = time.time()
    lap = Time.elapsed(endtime-Kernel.starttime)
    percall = (endtime-Kernel.starttime)/total
    print(f"{Method.fmt(Main, skip='otxt,txt')}")
    print(f"events: {total}")
    print(f"total: {lap} nrs: {Kernel.nrevents} call: {percall}")
    print(threading.enumerate())


def main():
    "main code."
    Parser.parse(Main, " ".join(sys.argv[1:]))
    Kernel.boot()
    Commands.scanner()
    if os.path.exists(Workdir.wdr):
        shutil.rmtree(Workdir.wdr)
    if "t" in Main.opts:
        nrcpu = os.cpu_count()
    else:
        nrcpu = 1
    Pool.init(nrcpu, CLI)
    Kernel.starttime = time.time()
    nrs = Main.index or 1
    thrs = []
    for _x in range(nrs):
        thrs.append(Threading.launch(payload, pre))
    for _x in range(nrs):
        thrs.append(Threading.launch(payload, examples))
    for _x in range(nrs):
        thrs.append(Threading.launch(payload, post))
    for thr in thrs:
        thr.join()
    Kernel.shutdown()


examples = {
    "cmd": [""],
    "dis": [""],
    "dpl": ["", "tittle.link"],
    "eml": ["", "root@localhost"],
    "flt": ["", "0"],
    "fnd": ["", "log", "todo"],
    "fie": ["", "log", "todo"],
    "lou": [""],
    "mbx": ["", "~/25-1-2013"],
    "man": ["", "nixt nixtniet@gmail.com Nixt Niet"],
    "nme": ["", "hnrss hn"],
    "now": [""],
    "pth": [""],
    "pwd": ["", "bla mekker"],
    "req": [""],
    "res": ["", "hnrss"],
    "sil": [""],
    "slg": [""],
    "srv": [""],
    "tbl": [""],
    'thr': [""],
    'upt': [""],
    'ver': [""],
}


pre = {
    "cfg": [
        '',
        'main',
        'irc',
        'rss',
        'main nick=mekker',
        'irc nick=mekker',
        'rss nick=mekker',
    ],
    "imp": [
        "",
        "testing/opml/feeds.opml",
    ],
    "log": ["", "test"],
    "rss": ["", "http://hnrss.org/newest", "https://www.icc-cpi.int/rss/records/all"],
    "tdo": ["", "test2"],
    "tmr": ["", "22:00 test"]
}


post = {
    "dbg": [""],
    "dne": ["", "mekker"],
    "exp": [""],
    "rem": ["", "rem hnrss"]
}


if __name__ == "__main__":
    Kernel.wrap(main, dofinal=final)

#!/usr/bin/env python3
# This file is placed in the Public Domain.


"stress test"


import os
import sys
import threading
import time


sys.path.insert(0, os.getcwd())


from rssbot.defines import CLI, Commands, Kernel, Main, Message, Parser
from rssbot.defines import Method, Pool, Time, Workdir


Workdir.wdr = ".test"


class Line(CLI):

    def raw(self, txt):
        if Main.verbose:
            CLI.raw(self, txt)


pool = Pool(Line)


def payload(todo):
    for cmd, example in todo.items():
        for ex in example:
            Kernel.nrevents += 1
            evt = Message()
            evt.kind = "command"
            evt.text = f"{cmd} {ex}"
            pool.put(evt)


def final():
    if "v" not in Main.opts:
        return
    total = Kernel.nrevents
    endtime = time.time()
    lap = Time.elapsed(endtime-Kernel.starttime)
    percall = (endtime-Kernel.starttime)/total
    print(f"{Method.fmt(Main, skip='otxt,txt')}")
    print(f"events: {total}")
    print(f"total: {lap} nrs: {Kernel.nrevents} call: %.6fs" % percall)
    print(threading.enumerate())


def main():
    Parser.parse(Main, " ".join(sys.argv[1:]))
    Main.local = True
    Main.threaded = "t" in Main.opts
    Main.verbose = "v" in Main.opts
    Kernel.boot()
    Commands.scanner()
    Kernel.nrevents = 0
    if Main.threaded:
        nrcpu = os.cpu_count()
    else:
        nrcpu = 1
    pool.init(nrcpu)
    Kernel.starttime = time.time()
    nrs = Main.index or 1
    for _x in range(nrs):
        payload(pre)
    for _x in range(nrs):
        payload(examples)
    for _x in range(nrs):
        payload(post)
    Kernel.shutdown()


examples = {
    "cmd": [""],
    "dis": [""],
    "dpl": ["", "tittle.link"],
    "eml": ["", "root@localhost"],
    "flt": ["", "0"],
    "fnd": ["", "log", "todo"],
    "fie": ["", "log", "todo"],
    "lou": [""],
    "mbx": ["", "~/25-1-2013"],
    "man": ["", "nixbot rssbotniet@gmail.com Nixt Niet"],
    "nme": ["", "hnrss hn"],
    "now": [""],
    "pth": [""],
    "pwd": ["", "bla mekker"],
    "req": [""],
    "res": ["", "hnrss"],
    "sil": [""],
    "slg": [""],
    "srv": ["--admin"],
    "tbl": [""],
    'thr': [""],
    'upt': [""],
    'ver': [""],
}


pre = {
    "cfg": [
        '',
        'main',
        'irc',
        'rss',
        'main nick=mekker',
        'irc nick=mekker',
        'rss nick=mekker',
    ],
    "imp": [
        "",
        "testing/opml/feeds.opml",
    ],
    "log": ["", "test"],
    "rss": ["", "http://hnrss.org/newest", "https://www.icc-cpi.int/rss/records/all"],
    "tdo": ["", "test2"],
    "tmr": ["", "22:00 test"]
}


post = {
    "dbg": [""],
    "dne": ["", "mekker"],
    "exp": [""],
    "rem": ["", "rem hnrss"]
}


if __name__ == "__main__":
    Kernel.wrap(main, dofinal=final)
